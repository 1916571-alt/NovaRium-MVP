APP_NAME=NovaRium V2 API
APP_ENV=dev
APP_DEBUG=true
API_PREFIX=/v2

# Supabase project base URL, e.g. https://xyzcompany.supabase.co
SUPABASE_URL=
# Supabase anon key for auth API calls
SUPABASE_ANON_KEY=
# Supabase JWT secret for verifying access token
SUPABASE_JWT_SECRET=replace_me
# Optional override secret for scenario share-link signing
SCENARIO_SHARE_SECRET=

# PostgreSQL DSN (Supabase)
DATABASE_URL=postgresql://user:password@host:5432/postgres?sslmode=require
